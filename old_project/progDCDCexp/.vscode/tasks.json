{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe сборка активного файла",
            "command": "C:\\msys64\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\*.c",
                "${fileDirname}\\ixxat_c_lib\\*.c",            
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-L",
                "${fileDirname}",
                "-l",
                "vcinpl",
                "-D",
                "_MSC_VER",
            ],
            "options": {
                "cwd":  "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Задача создана отладчиком."
        }
    ],
    "version": "2.0.0"
}